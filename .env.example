# ── Application ──────────────────────────────────────────────
APP_NAME=SME Insight Hub
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Database ─────────────────────────────────────────────────
# For local development: use docker-compose PostgreSQL
DATABASE_URL=postgresql+asyncpg://sme_user:sme_password@postgres:5432/sme_insight_hub
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# For production with Supabase:
# DATABASE_URL=postgresql+asyncpg://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# PostgreSQL Container (local docker-compose only)
POSTGRES_USER=sme_user
POSTGRES_PASSWORD=sme_password
POSTGRES_DB=sme_insight_hub

# ── Authentication ───────────────────────────────────────────
# Generate a secure key: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-key-change-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
# Add your Vercel frontend URL in production:
# CORS_ORIGINS=["https://your-project.vercel.app","http://localhost:5173"]
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:4173"]

# ── File Uploads ─────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# ── Supabase Storage (optional — replaces local file uploads) ─
# Create a project at https://supabase.com, then find these in Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=sme-documents

# ── Redis (Upstash — serverless Redis for Vercel/Railway) ────
# Create a database at https://console.upstash.com (free tier available)
# Use the REST URL format for Upstash: rediss://...@....upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# ── OCR ──────────────────────────────────────────────────────
TESSERACT_CMD=tesseract
OCR_LANGUAGE=eng+ben

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

# ── Logging & Error Tracking ─────────────────────────────────
LOG_LEVEL=INFO
# Sentry Error Tracking (create a free project at https://sentry.io):
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ── Frontend ─────────────────────────────────────────────────
# Development: local FastAPI
PUBLIC_API_URL=http://localhost:8000/api/v1
# Production (Railway backend):
# PUBLIC_API_URL=https://sme-backend.up.railway.app/api/v1

# ── Hosting Notes ────────────────────────────────────────────
# Frontend → Vercel: connect GitHub repo, set PUBLIC_API_URL env var
# Backend  → Railway: connect GitHub repo, set all env vars above
# Database → Supabase: free tier supports up to 500MB + 50,000 MAU
# Redis    → Upstash: free tier 10,000 requests/day
